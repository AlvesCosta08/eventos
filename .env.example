
# ==========================================================
# ADTC2 EVENTOS - CONFIGURACAO DE EXEMPLO
# ==========================================================

# APLICACAO
APP_NAME="ADTC2 Eventos"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# LOCALIZACAO
APP_TIMEZONE=America/Fortaleza
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

# MANUTENCAO
APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# SERVIDOR PHP
# PHP_CLI_SERVER_WORKERS=4

# SEGURANCA
BCRYPT_ROUNDS=12

# LOGS
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ==========================================================
# BANCO DE DADOS - MYSQL / DOCKER
# ==========================================================
# Ajustar nome do banco, usuario e senha conforme o Docker.
# A porta 3307 corresponde ao acesso pelo host.
# Dentro da rede Docker, a porta geralmente e 3306.

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3307
DB_DATABASE=adtc2_eventos
DB_USERNAME=adtc2
DB_PASSWORD=

# ==========================================================
# SESSOES
# ==========================================================

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# ==========================================================
# BROADCAST / ARQUIVOS / FILAS / CACHE
# ==========================================================

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

# ==========================================================
# MEMCACHED
# ==========================================================

MEMCACHED_HOST=127.0.0.1

# ==========================================================
# REDIS
# ==========================================================

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ==========================================================
# EMAIL
# ==========================================================

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ==========================================================
# AWS / S3
# ==========================================================

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ==========================================================
# VITE
# ==========================================================

VITE_APP_NAME="${APP_NAME}"
